<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@drawable/dialog_background"> <androidx.constraintlayout.widget.Guideline
    android:id="@+id/guideline_start_value"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:layout_constraintGuide_percent="0.45" /> <TextView
    android:id="@+id/tv_title"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:textSize="22sp"
    android:textStyle="bold"
    android:textColor="@android:color/black"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    tools:text="Details: ESP32-01" />

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_title" />

    <TextView
        android:id="@+id/label_status"
        style="@style/LabelStyle"
        android:text="Trạng thái:"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_online_status"
        style="@style/ValueStyle"
        app:layout_constraintTop_toTopOf="@+id/label_status"
        app:layout_constraintStart_toStartOf="@+id/guideline_start_value"
        tools:text="🟢 Online" />

    <TextView
        android:id="@+id/label_water_status"
        style="@style/LabelStyle"
        android:text="Tình trạng Nước:"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/label_status"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_water_status"
        style="@style/ValueStyle"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="@+id/label_water_status"
        app:layout_constraintStart_toStartOf="@+id/guideline_start_value"
        tools:text="WATER_DANGER" />

    <TextView
        android:id="@+id/label_water_level"
        style="@style/LabelStyle"
        android:text="Mực nước (m):"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/label_water_status"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_water_level"
        style="@style/ValueStyle"
        app:layout_constraintTop_toTopOf="@+id/label_water_level"
        app:layout_constraintStart_toStartOf="@+id/guideline_start_value"
        tools:text="1.25 m" />

    <TextView
        android:id="@+id/label_last_update"
        style="@style/LabelStyle"
        android:text="Cập nhật cuối:"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/label_water_level"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_last_update"
        style="@style/ValueStyle"
        app:layout_constraintTop_toTopOf="@+id/label_last_update"
        app:layout_constraintStart_toStartOf="@+id/guideline_start_value"
        android:textSize="14sp"
        tools:text="2 phút trước" />

    <Button
        android:id="@+id/btn_close"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Đóng"
        android:layout_marginTop="32dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@+id/label_last_update"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>