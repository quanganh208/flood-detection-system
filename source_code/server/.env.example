NODE_ENV=development
PORT=3000

# Database
# Docker mode: postgresql://flood_user:flood_password@postgres:5432/flood_detection?schema=public
# Dev mode (local): postgresql://flood_user:flood_password@localhost:5432/flood_detection?schema=public
DATABASE_URL=postgresql://flood_user:flood_password@localhost:5432/flood_detection?schema=public

# PlatformIO Builder Service
# Docker mode: http://platformio-builder:5000
# Dev mode (local): http://localhost:5001
PLATFORMIO_BUILDER_URL=http://localhost:5001

# MQTT Broker
# Docker mode: mqtt://mosquitto:1883
# Dev mode (local): mqtt://localhost:1883
MQTT_BROKER=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Firebase Cloud Messaging
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-adminsdk.json
