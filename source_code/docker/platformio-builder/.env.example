# PlatformIO Builder Service Configuration
# Copy to .env for local development

# Server settings
HOST=0.0.0.0
PORT=5000
DEBUG=false

# Build settings
BUILDS_DIR=/builds
MAX_BUILD_TIME=600
BUILD_CLEANUP_AGE=3600

# File upload settings
MAX_FILE_SIZE=10485760

# PlatformIO settings
PLATFORMIO_CORE_DIR=/home/builder/.platformio

# Logging
LOG_LEVEL=INFO
